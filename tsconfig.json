{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
	"moduleResolution": "node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "resolveJsonModule": true,
        "baseUrl": "./src",
        "paths": {
            "@/*": ["*"],
            "@components/*": ["components/*"],
            "@utils/*": ["utils/*"],
            "@services/*": ["services/*"],
            "@models/*": ["models/*"]

        },
        "lib": ["ES2020", "DOM"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", "**/*.d.ts"],
    "compileOnSave": false,
    "ts-node": {
        "files": true,
        "transpileOnly": true,
        "compilerOptions": {
            "module": "node16",
            "esModuleInterop": true,
            "skipLibCheck": true,
            "strict": true,
            "target": "ES2020",
            "resolveJsonModule": true,
            "baseUrl": "./src",
            "paths": {
                "@/*": ["*"],
                "@components/*": ["components/*"],
                "@utils/*": ["utils/*"],
                "@services/*": ["services/*"],
                "@models/*": ["models/*"]
                
        }
            }
        }   
}
